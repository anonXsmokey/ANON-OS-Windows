<Window x:Class="Anon.Shell.M0.AiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ANON AI" Width="820" Height="620" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AnonBackgroundBrush}" Foreground="{StaticResource AnonTextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ANON AI" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Local-first intelligence. No cloud key is required for the default Ollama provider." Foreground="{StaticResource AnonMutedTextBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Endpoint" FontSize="11" Foreground="{StaticResource AnonMutedTextBrush}" />
                <TextBox x:Name="EndpointBox" Padding="10" Margin="0,4,0,0" Background="#121925" Foreground="{StaticResource AnonTextBrush}" BorderBrush="{StaticResource AnonBorderBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Model" FontSize="11" Foreground="{StaticResource AnonMutedTextBrush}" />
                <TextBox x:Name="ModelBox" Padding="10" Margin="0,4,0,0" Background="#121925" Foreground="{StaticResource AnonTextBrush}" BorderBrush="{StaticResource AnonBorderBrush}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="150" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000"
                     Padding="14" Background="#121925" Foreground="{StaticResource AnonTextBrush}" BorderBrush="{StaticResource AnonBorderBrush}"
                     VerticalContentAlignment="Top" />
            <Border Grid.Row="1" Margin="0,14,0,0" Padding="16" Background="{StaticResource AnonSurfaceBrush}" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1" CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ResponseText" Text="No request yet." TextWrapping="Wrap" Foreground="{StaticResource AnonTextBrush}" /></ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource AnonMutedTextBrush}" VerticalAlignment="Center" />
            <Button x:Name="SendButton" Grid.Column="1" Content="SEND" Click="Send_Click" Padding="20,10" Background="{StaticResource AnonAccentBrush}" Foreground="#07101C" BorderThickness="0" FontWeight="SemiBold" />
        </Grid>
    </Grid>
</Window>

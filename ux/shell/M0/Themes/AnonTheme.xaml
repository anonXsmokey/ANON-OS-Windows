<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AnonBackgroundColor">#080A0F</Color>
    <Color x:Key="AnonSurfaceColor">#111621</Color>
    <Color x:Key="AnonSurfaceStrongColor">#1A2130</Color>
    <Color x:Key="AnonTopBarColor">#0D1119</Color>
    <Color x:Key="AnonBorderColor">#252D3B</Color>
    <Color x:Key="AnonTextColor">#F4F7FB</Color>
    <Color x:Key="AnonMutedTextColor">#8E99AA</Color>
    <Color x:Key="AnonAccentColor">#6EA8FF</Color>
    <Color x:Key="AnonAccentSoftColor">#182942</Color>
    <Color x:Key="AnonHeroColor">#0E1624</Color>

    <SolidColorBrush x:Key="AnonBackgroundBrush" Color="{StaticResource AnonBackgroundColor}" />
    <SolidColorBrush x:Key="AnonSurfaceBrush" Color="{StaticResource AnonSurfaceColor}" />
    <SolidColorBrush x:Key="AnonSurfaceStrongBrush" Color="{StaticResource AnonSurfaceStrongColor}" />
    <SolidColorBrush x:Key="AnonTopBarBrush" Color="{StaticResource AnonTopBarColor}" />
    <SolidColorBrush x:Key="AnonBorderBrush" Color="{StaticResource AnonBorderColor}" />
    <SolidColorBrush x:Key="AnonTextBrush" Color="{StaticResource AnonTextColor}" />
    <SolidColorBrush x:Key="AnonMutedTextBrush" Color="{StaticResource AnonMutedTextColor}" />
    <SolidColorBrush x:Key="AnonAccentBrush" Color="{StaticResource AnonAccentColor}" />
    <SolidColorBrush x:Key="AnonAccentSoftBrush" Color="{StaticResource AnonAccentSoftColor}" />
    <SolidColorBrush x:Key="AnonHeroBrush" Color="{StaticResource AnonHeroColor}" />

    <CornerRadius x:Key="AnonCardRadius">18</CornerRadius>
    <CornerRadius x:Key="AnonHeroRadius">24</CornerRadius>

    <Style x:Key="AnonPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AnonAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>

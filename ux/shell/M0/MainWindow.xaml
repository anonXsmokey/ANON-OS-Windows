<Window x:Class="Anon.Shell.M0.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" Title="ANON OS">
    <Grid x:Name="SurfaceRoot" Loaded="SurfaceRoot_Loaded" Background="{StaticResource AnonBackgroundGradient}" Opacity="1" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><CompositeTransform x:Name="SurfaceTransform" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>

        <Grid.RowDefinitions><RowDefinition Height="74" /><RowDefinition Height="*" /><RowDefinition Height="72" /></Grid.RowDefinitions>

        <!-- Top command bar -->
        <Border Grid.Row="0" Background="{StaticResource AnonTopBarBrush}" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="28,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource AnonAccentGradient}">
                        <TextBlock Text="A" FontSize="22" FontWeight="Bold" Foreground="#07101C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="ANON" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" />
                        <TextBlock Text="OPERATING ENVIRONMENT" FontSize="9" CharacterSpacing="150" Foreground="{StaticResource AnonMutedTextBrush}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="620" PlaceholderText="Search anything…  Apps · Games · Files · Settings" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" Style="{StaticResource AnonSearchBoxStyle}" />
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Padding="12,7" CornerRadius="10" Background="{StaticResource AnonSurfaceStrongBrush}"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="7" Height="7" Fill="{StaticResource AnonSuccessBrush}" VerticalAlignment="Center" /><TextBlock Text="ONLINE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel></Border>
                    <Button Content="⚙" Click="System_Click" Style="{StaticResource AnonIconButtonStyle}" AutomationProperties.Name="System settings" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search results -->
        <Border x:Name="LauncherPanel" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,68,0,0" Width="620" MaxHeight="310" Background="#F20E131D" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="8" Visibility="Collapsed">
            <ListView x:Name="LauncherResults" IsItemClickEnabled="True" ItemClick="LauncherResults_ItemClick" SelectionMode="None">
                <ListView.ItemTemplate><DataTemplate><Grid Padding="14,11"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AnonAccentSoftBrush}"><TextBlock Text="›" FontSize="22" Foreground="{StaticResource AnonAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Main desktop -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="42,34,42,36" MaxWidth="1500" HorizontalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,28">
                    <StackPanel Spacing="7"><TextBlock Text="WELCOME BACK" FontSize="11" FontWeight="SemiBold" CharacterSpacing="190" Foreground="{StaticResource AnonAccentBrush}" /><TextBlock Text="Your space." FontSize="44" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="A calm, capable Windows desktop with an ANON identity." FontSize="15" Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,10" CornerRadius="14" Background="{StaticResource AnonSurfaceBrush}" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1"><StackPanel Orientation="Horizontal" Spacing="10"><Ellipse Width="8" Height="8" Fill="{StaticResource AnonSuccessBrush}" VerticalAlignment="Center" /><StackPanel Spacing="1"><TextBlock Text="ANON CORE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="WINDOWS NATIVE" FontSize="9" CharacterSpacing="80" Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel></StackPanel></Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                    <Border x:Name="HeroSurface" Grid.Column="0" MinHeight="320" CornerRadius="{StaticResource AnonHeroRadius}" Background="{StaticResource AnonHeroGradient}" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1" Padding="34">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="17">
                                <Border HorizontalAlignment="Left" Padding="11,6" CornerRadius="9" Background="{StaticResource AnonAccentSoftBrush}"><TextBlock Text="DESIGNED FOR FOCUS" FontSize="10" FontWeight="SemiBold" CharacterSpacing="90" Foreground="{StaticResource AnonAccentBrush}" /></Border>
                                <TextBlock Text="Everything you need.&#x0a;Nothing in your way." FontSize="35" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" />
                                <TextBlock Text="Launch your apps, games and files from one coherent environment. Windows stays underneath; ANON is what you see." TextWrapping="Wrap" MaxWidth="650" FontSize="14" LineHeight="22" Foreground="{StaticResource AnonMutedTextBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="PLAY" Click="Play_Click" Style="{StaticResource AnonPrimaryButtonStyle}" /><Button Content="LIBRARY" Click="Library_Click" Style="{StaticResource AnonSecondaryButtonStyle}" /><Button Content="SYSTEM" Click="System_Click" Style="{StaticResource AnonSecondaryButtonStyle}" /></StackPanel>
                                <TextBlock x:Name="StatusText" Text="Ready." FontSize="11" Foreground="{StaticResource AnonMutedTextBrush}" />
                            </StackPanel>
                            <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="190" Height="190" Fill="#161F31" Stroke="{StaticResource AnonAccentBrush}" StrokeThickness="1" />
                                <Ellipse Width="142" Height="142" Fill="#101725" Stroke="#4B6280" StrokeThickness="1" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3"><TextBlock Text="ANON" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="CORE" FontSize="9" CharacterSpacing="260" HorizontalAlignment="Center" Foreground="{StaticResource AnonAccentBrush}" /></StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Spacing="18">
                        <Border CornerRadius="{StaticResource AnonCardRadius}" Background="{StaticResource AnonSurfaceBrush}" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1" Padding="22"><StackPanel Spacing="13"><Grid><TextBlock Text="SYSTEM" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="LIVE" HorizontalAlignment="Right" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AnonSuccessBrush}" /></Grid><TextBlock x:Name="CpuText" Text="CPU     —" FontSize="12" Foreground="{StaticResource AnonMutedTextBrush}" /><ProgressBar x:Name="CpuBar" Minimum="0" Maximum="100" Value="0" Height="5" /><TextBlock x:Name="MemoryText" Text="MEMORY  —" FontSize="12" Foreground="{StaticResource AnonMutedTextBrush}" /><ProgressBar x:Name="MemoryBar" Minimum="0" Maximum="100" Value="0" Height="5" /><TextBlock Text="GPU     telemetry coming next" FontSize="11" Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel></Border>
                        <Border CornerRadius="{StaticResource AnonCardRadius}" Background="{StaticResource AnonSurfaceBrush}" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1" Padding="22"><StackPanel Spacing="12"><TextBlock Text="VISUAL PROFILE" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><ComboBox x:Name="VisualProfile" SelectedIndex="1" SelectionChanged="VisualProfile_SelectionChanged"><ComboBoxItem Content="Maximum Performance" /><ComboBoxItem Content="Gaming" /><ComboBoxItem Content="Balanced" /><ComboBoxItem Content="Immersive" /></ComboBox><CheckBox x:Name="ReducedMotion" Content="Reduced motion" Click="ReducedMotion_Click" /><TextBlock Text="Control the character of the desktop without changing the underlying Windows installation." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel></Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="{StaticResource AnonCardRadius}" Background="{StaticResource AnonSurfaceBrush}" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1" Padding="22"><StackPanel Spacing="13"><TextBlock Text="FILES" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="A clean entry point to the Windows file system." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AnonMutedTextBrush}" /><Button Content="OPEN FILES" Click="Files_Click" Style="{StaticResource AnonSecondaryButtonStyle}" HorizontalAlignment="Left" /></StackPanel></Border>
                    <Border Grid.Column="2" CornerRadius="{StaticResource AnonCardRadius}" Background="{StaticResource AnonSurfaceBrush}" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1" Padding="22"><StackPanel Spacing="13"><TextBlock Text="APPLICATIONS" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="Your installed software, presented as an ANON library." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AnonMutedTextBrush}" /><Button Content="OPEN APPS" Click="Apps_Click" Style="{StaticResource AnonSecondaryButtonStyle}" HorizontalAlignment="Left" /></StackPanel></Border>
                    <Border Grid.Column="4" CornerRadius="{StaticResource AnonCardRadius}" Background="{StaticResource AnonSurfaceBrush}" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1" Padding="22"><StackPanel Spacing="13"><TextBlock Text="GAMES" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="A focused gaming surface with a dedicated performance mode." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AnonMutedTextBrush}" /><Button Content="OPEN GAMES" Click="Games_Click" Style="{StaticResource AnonSecondaryButtonStyle}" HorizontalAlignment="Left" /></StackPanel></Border>
                </Grid>

                <Border Grid.Row="3" CornerRadius="22" Background="#0E131D" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1" Padding="24">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock Text="ANON AI" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="Optional intelligence layer. Local Ollama models can run without a cloud key; online providers can be added later." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel><Button Grid.Column="1" Content="OPEN ANON AI" Click="Ai_Click" Style="{StaticResource AnonPrimaryButtonStyle}" VerticalAlignment="Center" /></Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Bottom dock: intentionally simple, keyboard-friendly and visually quiet. -->
        <Border Grid.Row="2" Background="#E60A0E16" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="⌂" Click="Home_Click" Style="{StaticResource AnonIconButtonStyle}" AutomationProperties.Name="Home" />
                    <Button Content="FILES" Click="Files_Click" Style="{StaticResource AnonNavButtonStyle}" />
                    <Button Content="APPS" Click="Apps_Click" Style="{StaticResource AnonNavButtonStyle}" />
                    <Button Content="GAMES" Click="Games_Click" Style="{StaticResource AnonNavButtonStyle}" />
                    <Button Content="ANON AI" Click="Ai_Click" Style="{StaticResource AnonNavButtonStyle}" />
                    <Button Content="SYSTEM" Click="System_Click" Style="{StaticResource AnonNavButtonStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><TextBlock Text="ANON OS" FontSize="10" FontWeight="SemiBold" CharacterSpacing="100" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="NATIVE SHELL" FontSize="9" CharacterSpacing="80" Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel>
            </Grid>
        </Border>

        <!-- First-run experience -->
        <Grid x:Name="FirstRunOverlay" Grid.RowSpan="3" Background="#D9070A10" Visibility="Collapsed">
            <Border Width="760" Padding="42" CornerRadius="30" Background="{StaticResource AnonSurfaceBrush}" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="22">
                    <StackPanel Orientation="Horizontal" Spacing="16"><Border Width="60" Height="60" CornerRadius="18" Background="{StaticResource AnonAccentGradient}"><TextBlock Text="A" FontSize="30" FontWeight="Bold" Foreground="#07101C" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="WELCOME TO ANON" FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="Your Windows installation. A completely different experience." FontSize="13" Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel></StackPanel>
                    <Border Height="1" Background="{StaticResource AnonBorderBrush}" />
                    <TextBlock Text="Make the environment yours." FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" />
                    <TextBlock Text="Choose a performance profile, visual identity and motion preference. Every choice can be changed later." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource AnonMutedTextBrush}" />
                    <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock Text="PERFORMANCE" FontSize="10" FontWeight="SemiBold" CharacterSpacing="100" Foreground="{StaticResource AnonMutedTextBrush}" /><ComboBox x:Name="FirstRunProfile" SelectedIndex="1"><ComboBoxItem Content="Maximum Performance" /><ComboBoxItem Content="Gaming" /><ComboBoxItem Content="Balanced" /><ComboBoxItem Content="Immersive" /></ComboBox></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="VISUAL IDENTITY" FontSize="10" FontWeight="SemiBold" CharacterSpacing="100" Foreground="{StaticResource AnonMutedTextBrush}" /><ComboBox x:Name="FirstRunTheme" SelectedIndex="0" SelectionChanged="FirstRunTheme_SelectionChanged"><ComboBoxItem Content="ANON Core" Tag="anon-core" /><ComboBoxItem Content="Aurora" Tag="aurora" /><ComboBoxItem Content="Carbon" Tag="carbon" /><ComboBoxItem Content="Pulse" Tag="pulse" /><ComboBoxItem Content="Crimson" Tag="crimson" /><ComboBoxItem Content="Minimal" Tag="minimal" /><ComboBoxItem Content="Immersive" Tag="immersive" /></ComboBox></StackPanel></Grid>
                    <CheckBox x:Name="FirstRunReducedMotion" Content="Use reduced motion" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="SKIP" Click="SkipFirstRun_Click" Style="{StaticResource AnonSecondaryButtonStyle}" /><Button Content="ENTER ANON" Click="CompleteFirstRun_Click" Style="{StaticResource AnonPrimaryButtonStyle}" /></StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

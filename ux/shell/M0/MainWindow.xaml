<Window
    x:Class="Anon.Shell.M0.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ANON OS — M0 Prototype">
    <Grid Background="{StaticResource AnonBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="ANON" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Margin="32,12" PlaceholderText="Search apps, games, files..." />
            <TextBlock Grid.Column="2" Text="M0 • PREVIEW" Foreground="{StaticResource AnonMutedTextBrush}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Padding="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="18">
                <TextBlock Text="YOUR SPACE" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" />
                <TextBlock Text="A first interactive ANON desktop surface." Foreground="{StaticResource AnonMutedTextBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,18,0,0">
                    <Button Content="PLAY" Click="Play_Click" />
                    <Button Content="LIBRARY" Click="Library_Click" />
                    <Button Content="SYSTEM" Click="System_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource AnonMutedTextBrush}" Margin="0,20,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border CornerRadius="{StaticResource AnonCardRadius}" Padding="22" Background="{StaticResource AnonSurfaceBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="SYSTEM" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" />
                        <TextBlock x:Name="CpuText" Text="CPU     —" Foreground="{StaticResource AnonMutedTextBrush}" />
                        <TextBlock Text="GPU     —" Foreground="{StaticResource AnonMutedTextBrush}" />
                        <TextBlock x:Name="MemoryText" Text="MEMORY  —" Foreground="{StaticResource AnonMutedTextBrush}" />
                    </StackPanel>
                </Border>
                <Border CornerRadius="{StaticResource AnonCardRadius}" Padding="22" Background="{StaticResource AnonSurfaceBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="VISUAL PROFILE" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" />
                        <ComboBox x:Name="VisualProfile" SelectedIndex="1" SelectionChanged="VisualProfile_SelectionChanged">
                            <ComboBoxItem Content="Maximum Performance" />
                            <ComboBoxItem Content="Gaming" />
                            <ComboBoxItem Content="Balanced" />
                            <ComboBoxItem Content="Immersive" />
                        </ComboBox>
                        <CheckBox x:Name="ReducedMotion" Content="Reduced motion" Click="ReducedMotion_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource AnonSurfaceBrush}" Padding="24,0">
            <StackPanel Orientation="Horizontal" Spacing="26" VerticalAlignment="Center">
                <Button Content="◉" Click="Home_Click" />
                <Button Content="FILES" Click="Files_Click" />
                <Button Content="APPS" Click="Apps_Click" />
                <Button Content="GAMES" Click="Games_Click" />
                <Button Content="SYSTEM" Click="System_Click" />
                <Button Content="ANON AI" Click="Ai_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

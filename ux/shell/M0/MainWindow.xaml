<Window x:Class="Anon.Shell.M0.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" Title="ANON OS — M0">
    <Grid x:Name="SurfaceRoot" Loaded="SurfaceRoot_Loaded" Background="{StaticResource AnonBackgroundBrush}" Opacity="1" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><CompositeTransform x:Name="SurfaceTransform" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="78" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource AnonTopBarBrush}" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AnonAccentBrush}"><TextBlock Text="A" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" /></Border><StackPanel Spacing="0"><TextBlock Text="ANON" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="GAMING DESKTOP" FontSize="10" CharacterSpacing="180" Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel></StackPanel>
                <TextBox x:Name="SearchBox" Grid.Column="1" Margin="44,12" PlaceholderText="Search apps, games, files, settings..." TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                <Border Grid.Column="2" Padding="12,7" CornerRadius="10" Background="{StaticResource AnonSurfaceStrongBrush}" VerticalAlignment="Center"><TextBlock Text="M0 • PREVIEW" Foreground="{StaticResource AnonMutedTextBrush}" /></Border>
            </Grid>
        </Border>
        <Border x:Name="LauncherPanel" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="226,68,0,0" Width="620" MaxHeight="260" Background="{StaticResource AnonSurfaceBrush}" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8" Visibility="Collapsed"><ListView x:Name="LauncherResults" IsItemClickEnabled="True" ItemClick="LauncherResults_ItemClick" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Padding="12,10"><StackPanel Spacing="2"><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
        <Grid Grid.Row="1" Padding="40,32"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,24"><TextBlock Text="YOUR SPACE" FontSize="38" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="One Windows desktop. Reimagined around the way gamers actually use it." FontSize="15" Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="1.2*" /><RowDefinition Height="18" /><RowDefinition Height="1*" /></Grid.RowDefinitions>
                    <Border x:Name="HeroSurface" Grid.Row="0" CornerRadius="{StaticResource AnonHeroRadius}" Background="{StaticResource AnonHeroBrush}" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1" Padding="28"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="16"><Border HorizontalAlignment="Left" Padding="10,5" CornerRadius="8" Background="{StaticResource AnonAccentSoftBrush}"><TextBlock Text="READY TO PLAY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AnonAccentBrush}" /></Border><TextBlock Text="Everything you need.&#x0a;Nothing fighting your game." FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="Launch games, manage your library, watch performance and keep the Windows desktop underneath you." TextWrapping="Wrap" MaxWidth="610" Foreground="{StaticResource AnonMutedTextBrush}" /><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="PLAY" Click="Play_Click" Style="{StaticResource AnonPrimaryButtonStyle}" /><Button Content="LIBRARY" Click="Library_Click" /><Button Content="SYSTEM" Click="System_Click" /></StackPanel><TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel><Border Grid.Column="1" Width="150" Height="150" CornerRadius="75" Background="{StaticResource AnonSurfaceStrongBrush}" BorderBrush="{StaticResource AnonAccentBrush}" BorderThickness="1" VerticalAlignment="Center"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2"><TextBlock Text="ANON" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="CORE" FontSize="10" CharacterSpacing="240" HorizontalAlignment="Center" Foreground="{StaticResource AnonAccentBrush}" /></StackPanel></Border></Grid></Border>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border CornerRadius="{StaticResource AnonCardRadius}" Background="{StaticResource AnonSurfaceBrush}" Padding="22" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1"><StackPanel Spacing="10"><TextBlock Text="QUICK LAUNCH" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="FILES" Click="Files_Click" /><Button Content="APPS" Click="Apps_Click" /><Button Content="GAMES" Click="Games_Click" /></StackPanel></StackPanel></Border><Border Grid.Column="2" CornerRadius="{StaticResource AnonCardRadius}" Background="{StaticResource AnonSurfaceBrush}" Padding="22" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1"><StackPanel Spacing="10"><TextBlock Text="ANON AI" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="Optional. Private. Toggle it whenever you want." TextWrapping="Wrap" Foreground="{StaticResource AnonMutedTextBrush}" /><Button Content="OPEN ANON AI" Click="Ai_Click" HorizontalAlignment="Left" /></StackPanel></Border></Grid>
                </Grid>
                <StackPanel Grid.Column="2" Spacing="18"><Border CornerRadius="{StaticResource AnonCardRadius}" Background="{StaticResource AnonSurfaceBrush}" Padding="22" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1"><StackPanel Spacing="12"><Grid><TextBlock Text="SYSTEM" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><TextBlock Text="LIVE" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AnonAccentBrush}" /></Grid><TextBlock x:Name="CpuText" Text="CPU     —" Foreground="{StaticResource AnonMutedTextBrush}" /><ProgressBar x:Name="CpuBar" Minimum="0" Maximum="100" Value="0" Height="5" /><TextBlock x:Name="MemoryText" Text="MEMORY  —" Foreground="{StaticResource AnonMutedTextBrush}" /><ProgressBar x:Name="MemoryBar" Minimum="0" Maximum="100" Value="0" Height="5" /><TextBlock Text="GPU     telemetry coming next" FontSize="12" Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel></Border><Border CornerRadius="{StaticResource AnonCardRadius}" Background="{StaticResource AnonSurfaceBrush}" Padding="22" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="1"><StackPanel Spacing="12"><TextBlock Text="VISUAL PROFILE" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AnonTextBrush}" /><ComboBox x:Name="VisualProfile" SelectedIndex="1" SelectionChanged="VisualProfile_SelectionChanged"><ComboBoxItem Content="Maximum Performance" /><ComboBoxItem Content="Gaming" /><ComboBoxItem Content="Balanced" /><ComboBoxItem Content="Immersive" /></ComboBox><CheckBox x:Name="ReducedMotion" Content="Reduced motion" Click="ReducedMotion_Click" /><TextBlock Text="Choose how ANON feels. Performance and visual fidelity remain user-controlled." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AnonMutedTextBrush}" /></StackPanel></Border></StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource AnonTopBarBrush}" BorderBrush="{StaticResource AnonBorderBrush}" BorderThickness="0,1,0,0" Padding="20,0"><Grid><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Button Content="◉" Click="Home_Click" /><Button Content="FILES" Click="Files_Click" /><Button Content="APPS" Click="Apps_Click" /><Button Content="GAMES" Click="Games_Click" /><Button Content="SYSTEM" Click="System_Click" /><Button Content="ANON AI" Click="Ai_Click" /></StackPanel><TextBlock Text="ANON CORE • WINDOWS NATIVE" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource AnonMutedTextBrush}" /></Grid></Border>
    </Grid>
</Window>
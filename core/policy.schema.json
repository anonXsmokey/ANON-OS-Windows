{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ANON OS Windows Policy",
  "type": "object",
  "required": ["id", "version", "description", "risk", "actions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "risk": {"enum": ["safe", "caution", "high"]},
    "requires_backup": {"type": "boolean"},
    "supported_builds": {"type": "array", "items": {"type": "string"}},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": {"enum": ["registry", "service", "scheduled_task", "package", "setting", "command"]},
          "target": {"type": "string"},
          "value": {},
          "rollback": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
